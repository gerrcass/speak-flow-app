{
  "$meta": {
    "name": "speak-flow",
    "description": "W3C Design Tokens source of truth. Never hand-edit generated outputs (tokens.css, tokens.ts). Edit this file, then generate.",
    "method": "https://www.designsystems.one/ai-ready/structure"
  },
  "color": {
    "blue": {
      "600": { "$value": "#2563eb", "$type": "color" },
      "500": { "$value": "#3b82f6", "$type": "color" }
    },
    "red": {
      "600": { "$value": "#dc2626", "$type": "color" }
    },
    "green": {
      "600": { "$value": "#16a34a", "$type": "color" }
    },
    "amber": {
      "500": { "$value": "#f59e0b", "$type": "color" }
    },
    "neutral": {
      "900": { "$value": "#111827", "$type": "color" },
      "100": { "$value": "#f3f4f6", "$type": "color" },
      "0": { "$value": "#ffffff", "$type": "color" }
    },
    "action": {
      "primary": {
        "$value": "{color.blue.600}",
        "$type": "color",
        "$description": "Primary brand action. Record button, primary CTA, key nav."
      },
      "primary-hover": {
        "$value": "{color.blue.500}",
        "$type": "color",
        "$description": "Hover state of primary action. Never use as default."
      },
      "danger": {
        "$value": "{color.red.600}",
        "$type": "color",
        "$description": "Destructive intent. Delete history, discard attempt."
      }
    },
    "feedback": {
      "pass": {
        "$value": "{color.green.600}",
        "$type": "color",
        "$description": "Score >85%. Word pronounced correctly."
      },
      "warn": {
        "$value": "{color.amber.500}",
        "$type": "color",
        "$description": "Score 70-85%. Close, drill recommended."
      },
      "fail": {
        "$value": "{color.red.600}",
        "$type": "color",
        "$description": "Score <70%. Failed word, send to SRS drill."
      }
    },
    "surface": {
      "app": {
        "$value": "{color.neutral.100}",
        "$type": "color",
        "$description": "Default app background."
      }
    },
    "fg": {
      "primary": {
        "$value": "{color.neutral.900}",
        "$type": "color",
        "$description": "Default text on light surfaces."
      },
      "on-primary": {
        "$value": "{color.neutral.0}",
        "$type": "color",
        "$description": "Text on top of primary action background."
      }
    }
  },
  "space": {
    "inset": {
      "sm": { "$value": "8px", "$type": "dimension", "$description": "Tight padding. Chips, badges." },
      "md": { "$value": "16px", "$type": "dimension", "$description": "Default control padding. Buttons, cards." }
    }
  },
  "radius": {
    "control": {
      "sm": { "$value": "6px", "$type": "dimension", "$description": "Buttons and inputs. Never per-pixel values in components." }
    }
  }
}
