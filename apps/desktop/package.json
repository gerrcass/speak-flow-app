{
  "name": "@speak-flow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Speak Flow desktop shell: Electron + React TS + supervised Python sidecar",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "vite build && tsc -p tsconfig.main.json && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit",
    "tokens:build": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs && git diff --exit-code -- generated",
    "hex-gate": "node scripts/hex-gate.mjs",
    "lint": "eslint src tests && node scripts/hex-gate.mjs",
    "test": "node --test \"tests/*.test.mjs\" && node --experimental-strip-types --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@gdp-ts/core": "^0.1.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "app.speakflow.desktop",
    "productName": "Speak Flow",
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "!**/models/**",
      "!**/*.pt",
      "!**/*.bin",
      "!**/*.onnx"
    ],
    "extraResources": [
      {
        "from": "../content",
        "to": "content",
        "filter": [
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/speak-flow/updates"
    }
  }
}
